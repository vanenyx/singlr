#!/usr/bin/env python3
"""Dedicated login session; never invoke startplasma or change shared KDE units."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parent))
import singlr_kwin


def run(*args, **kwargs):
    return subprocess.run(args, check=True, text=True, **kwargs)


def layout():
    dev = os.environ.get('SINGLR_DEV_ROOT')
    root = Path(dev) if dev else Path('/usr/lib/singlr')
    if not root.is_absolute():
        raise RuntimeError('SINGLR_DEV_ROOT debe ser una ruta absoluta')
    binary = root / 'shell/session/build/singlr-shell' if dev else root / 'singlr-shell'
    qml = root / 'shell/qml' if dev else root / 'qml'
    return binary, qml


def active(unit):
    result = subprocess.run(['systemctl', '--user', 'show', unit,
                             '--property=ActiveState', '--value'],
                            check=True, text=True, capture_output=True)
    return result.stdout.strip() not in ('inactive', 'failed', '')


def manager_environment():
    result = run('busctl', '--user', '--json=short', 'get-property',
                 'org.freedesktop.systemd1', '/org/freedesktop/systemd1',
                 'org.freedesktop.systemd1.Manager', 'Environment', capture_output=True)
    return dict(item.split('=', 1) for item in json.loads(result.stdout)['data'])


def shutdown_running():
    # NameHasOwner never activates plasma-shutdown. As in startplasma 6.8,
    # do not reap the login while it is still performing Reboot/PowerOff.
    result = run('busctl', '--user', '--json=short', 'call',
                 'org.freedesktop.DBus', '/org/freedesktop/DBus',
                 'org.freedesktop.DBus', 'NameHasOwner', 's', 'org.kde.Shutdown',
                 capture_output=True)
    return bool(json.loads(result.stdout)['data'][0])


def wait_for_session_end(stopping):
    while not stopping():
        if not active('singlr-workspace.target') and not shutdown_running():
            return
        time.sleep(1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true', help='mostrar el plan sin bus ni cambios')
    parser.add_argument('--shell', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()
    binary, qml = layout()
    command = [str(binary), str(qml), str(qml / 'Shell.qml')]
    if args.dry_run:
        print('Shell:', json.dumps(command, ensure_ascii=False))
        print('KWin: recuperar pendiente → backup persistente → aplicar antes de arrancar → restaurar tras parar')
        print('Sesión: importar entorno → start singlr-workspace.target (KWin → ksmserver → restoreSession)')
        print('Final: salida de ksmserver → target parado → esperar org.kde.Shutdown → limpiar grafo/entorno → terminar PAM')
        print('No se inicia plasma-workspace/core, plasmashell ni KRunner; se conserva autostart XDG.')
        return 0
    if not binary.is_file() or not os.access(binary, os.X_OK) or not (qml / 'Shell.qml').is_file():
        raise RuntimeError('Falta binario/QML empaquetado, o build de desarrollo; véase session/README.md')
    if args.shell:
        os.execv(command[0], command)
    if os.geteuid() == 0:
        raise RuntimeError('La sesión se ejecuta como usuario, nunca como root')
    if os.environ.get('WAYLAND_DISPLAY') or os.environ.get('DISPLAY'):
        raise RuntimeError('Iniciar desde el greeter, fuera de un escritorio activo')
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    # Use the PAM user bus that also owns systemd; never create a private bus.
    os.environ['DBUS_SESSION_BUS_ADDRESS'] = f'unix:path={runtime}/bus'
    # The user manager and KDE D-Bus names are per UID, not per login session.
    with (runtime / 'singlr-session.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        for unit in ('graphical-session.target', 'plasma-workspace.target',
                     'plasma-kwin_wayland.service', 'plasma-plasmashell.service',
                     'plasma-krunner.service', 'plasma-ksmserver.service', 'singlr-workspace.target'):
            if active(unit):
                raise RuntimeError(f'Otra sesión/unidad está activa: {unit}; no se modifica')
        old = manager_environment()
        env = {'XDG_SESSION_TYPE': 'wayland', 'XDG_SESSION_DESKTOP': 'Singlr',
               'XDG_CURRENT_DESKTOP': 'Singlr:KDE', 'XDG_MENU_PREFIX': 'plasma-',
               'KDE_FULL_SESSION': 'true', 'KDE_SESSION_VERSION': '6',
               'PLASMA_DEFAULT_SHELL': 'org.singlr.desktop',
               'KDE_SESSION_UID': str(os.getuid()), 'QT_WAYLAND_RECONNECT': '1',
               'SINGLR_DEV_ROOT': os.environ.get('SINGLR_DEV_ROOT', ''),
               'XDG_SESSION_ID': os.environ.get('XDG_SESSION_ID', '')}
        # Include locale and XDG paths explicitly, never import the entire environment.
        env.update({key: value for key, value in os.environ.items()
                    if key in ('LANG', 'LANGUAGE', 'XDG_CONFIG_HOME', 'XDG_CONFIG_DIRS',
                               'XDG_DATA_HOME', 'XDG_DATA_DIRS', 'XDG_CACHE_HOME', 'XDG_STATE_HOME')
                    or key.startswith('LC_')
                    # pam_kwallet5 deja la contraseña en un socket y lo anuncia en PAM_KWALLET5_LOGIN;
                    # sin esta variable, plasma-kwallet-pam no desbloquea la cartera (pedía contraseña y
                    # los navegadores esperaban a KWallet al iniciar).
                    or key.startswith('PAM_KWALLET')})
        # Distribución de teclado del sistema (locale1), como hace startplasma-wayland: sin esto KWin
        # arranca con la distribución por defecto (inglés) si kxkbrc no define otra.
        env.update(keyboard_environment())
        # Cursor para apps X11/GTK, como hace startplasma-wayland (KWin lo lee de kcminputrc por su cuenta).
        env.update(cursor_environment())
        # ksmserver publishes SESSION_MANAGER through D-Bus/systemd. Restore it
        # as well so a subsequent Plasma login cannot inherit the dead ICE socket.
        keys = set(env) | {'DISPLAY', 'WAYLAND_DISPLAY', 'WAYLAND_SOCKET', 'XAUTHORITY', 'SESSION_MANAGER', 'ICEAUTHORITY'}
        stopping = False
        started = False

        def terminate(_signum, _frame):
            nonlocal stopping
            stopping = True

        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(sig, terminate)
        try:
            singlr_kwin.apply(recover_pending=True)
            run('dbus-update-activation-environment', '--systemd',
                *(f'{key}={value}' for key, value in env.items()),
                'DISPLAY=', 'WAYLAND_DISPLAY=', 'WAYLAND_SOCKET=', 'XAUTHORITY=', 'SESSION_MANAGER=', 'ICEAUTHORITY=')
            # Empty still counts as "set" to KWin's backend detection. Remove these
            # from systemd AFTER the D-Bus update, so KWin selects DRM, not nesting.
            run('systemctl', '--user', 'unset-environment', 'DISPLAY', 'WAYLAND_DISPLAY',
                'WAYLAND_SOCKET', 'XAUTHORITY', 'SESSION_MANAGER', 'ICEAUTHORITY')
            # KWin wrapper publishes the real display variables before its dbus readiness.
            run('systemctl', '--user', 'start', 'singlr-workspace.target')
            started = True
            wait_for_session_end(lambda: stopping)
            return 0
        finally:
            # The shell is part of the target and cannot finish logout itself.
            # Stay alive through graph cleanup, then ask logind to reap this PAM
            # session's remaining applications. Never terminate the entire UID.
            try:
                # Only reached after refusing an existing graphical session, under our UID lock.
                try:
                    run('systemctl', '--user', 'stop', 'singlr-workspace.target', 'graphical-session.target')
                finally:
                    try:
                        singlr_kwin.restore()
                    finally:
                        restore_environment(old, keys)
            finally:
                session_id = os.environ.get('XDG_SESSION_ID')
                if started and session_id:
                    run('loginctl', 'terminate-session', session_id)


def cursor_environment():
    def read(key, default):
        result = subprocess.run(['kreadconfig6', '--file', 'kcminputrc', '--group', 'Mouse', '--key', key,
                                 '--default', default], text=True, capture_output=True)
        return (result.stdout.strip() if result.returncode == 0 else '') or default
    return {'XCURSOR_THEME': read('cursorTheme', 'breeze_cursors'), 'XCURSOR_SIZE': read('cursorSize', '24')}


def keyboard_environment():
    env = {}
    for prop, key in (('X11Layout', 'XKB_DEFAULT_LAYOUT'), ('X11Model', 'XKB_DEFAULT_MODEL'),
                      ('X11Variant', 'XKB_DEFAULT_VARIANT'), ('X11Options', 'XKB_DEFAULT_OPTIONS')):
        result = subprocess.run(['busctl', '--system', '--json=short', 'get-property', 'org.freedesktop.locale1',
                                 '/org/freedesktop/locale1', 'org.freedesktop.locale1', prop],
                                text=True, capture_output=True)
        if result.returncode == 0:
            value = json.loads(result.stdout).get('data', '')
            if value:
                env[key] = value
    return env


def restore_environment(old, keys):
    try:
        run('dbus-update-activation-environment',
            *(f'{key}={old.get(key, "")}' for key in sorted(keys)))
    finally:
        run('systemctl', '--user', 'unset-environment', *sorted(keys - old.keys()))
        previous = [f'{key}={old[key]}' for key in sorted(keys & old.keys())]
        if previous:
            run('systemctl', '--user', 'set-environment', *previous)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, KeyError, ValueError, subprocess.CalledProcessError) as error:
        print(f'Singlr: {error}', file=sys.stderr)
        sys.exit(1)
