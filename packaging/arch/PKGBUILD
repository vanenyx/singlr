# Local source package: run the preparation command in packaging/README.md first.
pkgname=singlr-desktop
pkgver=0.1.0
pkgrel=2
pkgdesc='Singlr desktop session for KDE Plasma 6 (phase 1 prototype)'
arch=('x86_64')
# Distribution license remains pending; this local package is not a release.
license=('LicenseRef-Singlr-Pending')
depends=('bash' 'python' 'qt6-base' 'qt6-declarative' 'qt6-svg'
         'kservice' 'kio' 'kwindowsystem' 'kglobalaccel' 'layer-shell-qt' 'libkscreen'
         'networkmanager' 'plasma-workspace=6.8.1' 'plasma-desktop' 'plasma-integration' 'dolphin' 'kwayland' 'kguiaddons>=6.29' 'kwin=6.8.1'
         'plasma-nm' 'plasma-pa' 'bluez-qt' 'bluedevil' 'kitemmodels' 'kcmutils' 'milou'
         'breeze-icons' 'breeze-gtk' 'kde-gtk-config' 'xsettingsd'
         'powerdevil' 'polkit-kde-agent' 'xdg-desktop-portal-kde'
         'pipewire' 'pipewire-pulse' 'wireplumber' 'systemd' 'kdialog')
makedepends=('cmake' 'ninja' 'extra-cmake-modules' 'pkgconf' 'vulkan-headers' 'qt6-shadertools')
source=("singlr-$pkgver.tar.gz")
sha256sums=('SKIP') # Local development snapshot; pin a checksum before distributing.

build() {
    cmake -S "$srcdir/singlr-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib
    cmake --build build
}


# P-032: CMake installs shell material only; KDE supplies workspace packages.
package() {
    DESTDIR="$pkgdir" cmake --install build
}
