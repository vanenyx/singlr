[Unit]
Description=Singlr Desktop Shell
Requires=plasma-kwin_wayland.service
BindsTo=plasma-kwin_wayland.service
After=plasma-kwin_wayland.service
# Match plasma-plasmashell.service: ksmserver publishes SESSION_MANAGER and
# ICEAUTHORITY before acquiring its BusName. Launchers must inherit that
# environment, otherwise their XSMP apps cannot save or negotiate logout.
After=plasma-ksmserver.service
Before=plasma-kded6.service
PartOf=singlr-workspace.target graphical-session.target
StartLimitIntervalSec=60s
StartLimitBurst=3
OnFailure=singlr-shell-failed.service

[Service]
# Type=simple: declarar BusName=org.kde.plasmashell choca con plasma-plasmashell.service
# (systemd rechaza dos unidades con el mismo nombre). El shell toma el nombre en tiempo de ejecución.
Type=simple
ExecStart=/usr/lib/singlr/startsinglr-wayland --shell
Slice=session.slice
TimeoutStartSec=30
TimeoutStopSec=10
Restart=on-failure
StandardOutput=journal
StandardError=journal
SyslogIdentifier=singlr-shell
Environment="QT_MESSAGE_PATTERN=%%{type} %%{category}: %%{message}"
