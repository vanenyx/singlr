#!/bin/sh
# Session identity and distribution defaults only; Plasma owns the lifecycle.
set -eu
# The replacement unit is only used by Plasma's supported systemd boot path.
boot=$(kreadconfig6 --file startkderc --group General --key systemdBoot --default true)
case "$boot" in
    [Ff][Aa][Ll][Ss][Ee])
        echo 'Singlr requiere systemdBoot de Plasma; retire systemdBoot=false de startkderc antes del login.' >&2
        exit 1 ;;
esac
export XDG_SESSION_DESKTOP=Singlr
export PLASMA_DEFAULT_SHELL=org.singlr.desktop
export XDG_CONFIG_DIRS="/usr/lib/singlr/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
exec /usr/lib/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland "$@"
