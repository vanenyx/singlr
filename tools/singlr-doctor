#!/usr/bin/env python3
"""Informe adjuntable por lista permitida; nunca exporta entorno ni mensajes libres."""
import argparse
from collections import Counter
import datetime
import json
import os
from pathlib import Path
import re
import subprocess

UNITS = ('singlr-workspace.target', 'singlr-shell.service', 'plasma-kwin_wayland.service',
         'plasma-ksmserver.service', 'plasma-kded6.service', 'plasma-powerdevil.service',
         'plasma-restoresession.service', 'graphical-session.target',
         'plasma-plasmashell.service', 'plasma-krunner.service')
PROPERTIES = ('LoadState', 'ActiveState', 'SubState', 'Result', 'MainPID', 'NRestarts',
              'StartLimitBurst', 'StartLimitIntervalUSec', 'Restart')


def command(*args):
    try:
        p = subprocess.run(args, text=True, capture_output=True, timeout=8,
                           env=os.environ | {'LC_ALL': 'C', 'SYSTEMD_COLORS': '0'})
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 127, ''


def unit(name):
    code, out = command('systemctl', '--user', 'show', name,
                        '--property=' + ','.join(PROPERTIES))
    if code:
        return {'available': False}
    return {k: v for line in out.splitlines() if '=' in line
            for k, v in [line.split('=', 1)] if k in PROPERTIES
            and re.fullmatch(r'[a-zA-Z0-9_. -]*', v)} | {'available': True}


def errors():
    code, raw = command('journalctl', '--user', '-b', '--since=-30min', '-p', 'warning',
                        '-n', '200', '-o', 'json', '--no-pager',
                        *[a for u in UNITS for a in ('-u', u)],
                        '+', '_COMM=kscreenlocker_g')
    counts = Counter()
    events = []
    if code:
        return {'available': False}
    for line in raw.splitlines():
        try:
            row = json.loads(line)
        except ValueError:
            continue
        message = str(row.get('MESSAGE', '')).lower()
        category = ('lockscreen-fallback' if 'falling back' in message and 'lock' in message else
                    'qml' if any(s in message for s in ('qml', 'typeerror', 'referenceerror')) else
                    'crash' if any(s in message for s in ('core-dump', 'segfault', 'signal')) else 'other')
        counts[category] += 1
        # Deliberately omit MESSAGE, hostname, UID, PID, paths and arbitrary unit names.
        stamp = str(row.get('__REALTIME_TIMESTAMP', ''))
        priority = str(row.get('PRIORITY', ''))
        events.append({'time_us': stamp if stamp.isdigit() else None,
                       'priority': priority if priority in tuple('01234567') else None,
                       'category': category,
                       'unit': row.get('_SYSTEMD_USER_UNIT') if row.get('_SYSTEMD_USER_UNIT') in UNITS else 'locker-or-unknown'})
    return {'available': True, 'window': 'boot, last 30 min; max 200 warnings',
            'counts': dict(counts), 'events': events}


def report():
    versions = {}
    for package in ('plasma-workspace', 'kwin', 'qt6-base', 'qt6-declarative', 'singlr-desktop', 'systemd'):
        code, out = command('pacman', '-Q', package)
        fields = out.split()
        versions[package] = fields[1] if not code and len(fields) == 2 and re.fullmatch(r'[\w.+:~-]+', fields[1]) else None
    config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
    code, raw = command('systemctl', '--user', 'show', 'singlr-shell.service', '-p', 'Environment', '--value')
    pid = unit('singlr-shell.service').get('MainPID', '0')
    running_dev = None
    if str(pid).isdigit() and int(pid):
        try:
            running_dev = any(x.startswith(b'SINGLR_DEV_ROOT=') and x != b'SINGLR_DEV_ROOT='
                              for x in Path('/proc', pid, 'environ').read_bytes().split(b'\0'))
        except OSError:
            pass
    return {'schema': 1, 'utc': datetime.datetime.now(datetime.timezone.utc).isoformat(),
            'versions': versions,
            'session': {key: os.environ.get(key) if os.environ.get(key) in allowed else 'other-or-unset'
                        for key, allowed in {'XDG_SESSION_TYPE': ('wayland', 'x11', 'tty'),
                                             'XDG_CURRENT_DESKTOP': ('Singlr:KDE', 'KDE'),
                                             'XDG_SESSION_DESKTOP': ('Singlr', 'KDE', 'plasma')}.items()},
            'development': {'user_dropin': (config / 'systemd/user/singlr-shell.service.d/dev-channel.conf').is_file(),
                            'configured': bool(re.search(r'SINGLR_DEV_ROOT=(?!["\s]|$)', raw)) if not code else None,
                            'running': running_dev,
                            # User copies take precedence over the package in KWin's search path.
                            'shadowed_kwin_packages': sorted(
                                f'{kind}/{name}' for kind, names in (('effects', ('singlr-liquidglass',)),)
                                for name in names
                                if (Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share')) / 'kwin' / kind / name).exists()
                                or (Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share')) / 'kwin' / kind / name).is_symlink())},
            'units': {u: unit(u) for u in UNITS}, 'recent_errors': errors(),
            'privacy': 'No messages, environment dump, account, hostname, network, filenames or credentials. Missing data is unknown, never PASS.'}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, help='archivo nuevo, privado (0600); no sobrescribe')
    args = parser.parse_args()
    payload = json.dumps(report(), indent=2) + '\n'
    if args.output:
        fd = os.open(args.output, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as stream:
            stream.write(payload)
    else:
        print(payload, end='')


if __name__ == '__main__':
    main()
