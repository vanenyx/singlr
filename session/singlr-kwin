#!/usr/bin/env python3
"""Apply/recover Singlr KWin settings; usable from Plasma after an interrupted login."""
import subprocess
import sys
from singlr_kwin import main

if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'Singlr KWin: {error}', file=sys.stderr)
        sys.exit(1)
