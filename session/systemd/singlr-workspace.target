[Unit]
Description=Singlr Wayland Workspace
# Portals start AFTER graphical-session.target: do not add implicit After=Wants.
DefaultDependencies=no
Requires=graphical-session.target plasma-kwin_wayland.service
BindsTo=graphical-session.target plasma-kwin_wayland.service
# Like plasma-core.target, keep KWin and the session alive if the shell fails.
Wants=singlr-shell.service
# BusName=org.kde.ksmserver in the KDE unit supplies readiness after KWin.
# A successful KDE logout quits ksmserver; its exit must stop our target too.
Requires=plasma-ksmserver.service
BindsTo=plasma-ksmserver.service
Wants=plasma-restoresession.service
PartOf=graphical-session.target
Wants=graphical-session-pre.target plasma-kded6.service
Wants=plasma-knighttimed.service
Wants=plasma-polkit-agent.service plasma-powerdevil.service
Wants=plasma-xdg-desktop-portal-kde.service xdg-desktop-portal.service
Wants=plasma-kactivitymanagerd.service
Wants=pipewire.socket pipewire-pulse.socket wireplumber.service
# Servicios que también arranca plasma-workspace.target (salvo plasmashell y KRunner):
# desbloqueo de KWallet con la contraseña de inicio (cookies y claves de navegadores), atajos,
# accesibilidad, iconos de bandeja XEmbed, menús globales, carpetas de usuario y apps de inicio automático.
Wants=plasma-kwallet-pam.service plasma-kglobalaccel.service plasma-kaccess.service
Wants=plasma-xembedsniproxy.service plasma-gmenudbusmenuproxy.service xdg-user-dirs.service
Wants=xdg-desktop-autostart.target
After=graphical-session-pre.target plasma-kwin_wayland.service singlr-shell.service
After=plasma-ksmserver.service
Before=graphical-session.target
Before=plasma-restoresession.service xdg-desktop-autostart.target
Conflicts=shutdown.target
Before=shutdown.target
